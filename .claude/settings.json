{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun:*)",
      "Bash(turbo lint:*)",
      "Bash(turbo typecheck:*)",
      "Bash(turbo format:*)",
      "Bash(turbo test:*)",
      "Bash(turbo i18n:*)",
      "Bash(turbo build:*)",
      "Bash(turbo db:generate:*)",
      "Bash(turbo dev:*)",
      "Bash(agent-browser:*)",
      "Bash(bunx @tanstack/cli:*)",
      "WebFetch(domain:better-auth.com)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:motion.dev)",
      "WebFetch(domain:turborepo.com)",
      "WebFetch(domain:docs.sqd.ai)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:effect.website)",
      "WebFetch(domain:oxc.rs)"
    ],
    "deny": ["Bash(npm:*)", "Bash(pnpm:*)"]
  },
  "enabledMcpjsonServers": ["bun", "context7", "sentry"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path'); case \"$f\" in *.ts|*.tsx) bunx oxfmt \"$f\" >/dev/null && bunx oxlint --type-aware --fix \"$f\" 1>&2 || exit 2;; esac"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "agent-browser@agent-browser": true,
    "planetscale@planetscale": true
  },
  "extraKnownMarketplaces": {
    "agent-browser": {
      "source": {
        "source": "git",
        "url": "https://github.com/vercel-labs/agent-browser.git"
      },
      "autoUpdate": true
    },
    "planetscale": {
      "source": {
        "source": "git",
        "url": "https://github.com/planetscale/claude-plugin.git"
      },
      "autoUpdate": true
    }
  }
}
