{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": true
    },
    "test": {
      "cache": true,
      "inputs": ["src/**/*.ts", "tests/**/*.ts", "tests/fixtures/**/*.json"]
    }
  }
}
