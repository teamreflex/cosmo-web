{
  "name": "@apollo/image",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./runtime": "./src/runtime.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
    "lint": "bun --bun oxlint --type-aware --type-check",
    "lint:fix": "bun --bun oxlint --type-aware --type-check --fix",
    "test": "bun test",
    "image:mirror": "bun --env-file=../../.env --env-file=../../.env.local scripts/mirror.ts",
    "typecheck": "tsc --pretty --noEmit",
    "format": "oxfmt ."
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@apollo/database": "workspace:*",
    "@apollo/lint": "workspace:*",
    "@apollo/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-orm": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
