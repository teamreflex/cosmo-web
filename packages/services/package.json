{
  "name": "@apollo/services",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./database-web": "./src/database-web.ts",
    "./redis": "./src/redis.ts"
  },
  "scripts": {
    "lint": "bun --bun oxlint --type-aware --type-check",
