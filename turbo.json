{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "//#services": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "bunfig.toml"
      ]
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^lint"],
      "inputs": ["**/*.ts", "**/*.tsx", "oxlint.config.ts", "!node_modules/**"]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["^lint:fix"]
    },
    "format": {
      "cache": true,
      "dependsOn": ["^format"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "$TURBO_ROOT$/bunfig.toml",
        "!node_modules/**"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "db:seed": {
      "cache": false,
      "dependsOn": ["//#services"]
    },
    "db:seed:staff": {
      "cache": false,
      "dependsOn": ["//#services"]
    },
    "image:mirror": {
      "cache": false
    },
    "proxy:audio": {
      "persistent": true,
      "cache": false
    },
    "proxy:motion": {
      "persistent": true,
      "cache": false
    }
  }
}
