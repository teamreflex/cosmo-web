{
  "name": "apollo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "services": "dotenv -c -- ./start.sh"
  },
  "dependencies": {
    "@sentry/bun": "catalog:"
