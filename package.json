{
  "name": "apollo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "services": "dotenv -c -- ./start.sh"
  },
  "dependencies": {
    "@sentry/bun": "catalog:"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "dotenv-cli": "^11.1.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.3"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@better-auth/api-key": "1.7.18",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@effect/atom-react": "4.1.3",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.87.5",
    "@effect/platform-bun": "4.1.3",
    "@sentry/bun": "^11.11.0",
    "@types/bun": "1.4.4",
    "auth": "1.7.18",
    "better-auth": "1.7.18",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.3",
    "ofetch": "^1.5.1",
    "turbo": "2.11.10",
    "typesense": "^2.1.0",
    "typescript": "7.0.2",
    "zod": "^4.6.7"
  },
  "patchedDependencies": {
    "effect@4.1.3": "patches/effect@4.1.3.patch",
    "@effect/platform-bun@4.1.3": "patches/@effect%2Fplatform-bun@4.1.3.patch",
    "@subsquid/http-client@1.9.0": "patches/@subsquid%2Fhttp-client@1.9.0.patch"
  }
