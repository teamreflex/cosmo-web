{
  "name": "chat",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "PORT=3001 bun run --bun --watch --env-file=../../.env --env-file=../../.env.local ./src/main.ts",
    "build": "bun build ./src/main.ts --outdir ./dist --target bun",
    "start": "bun run --bun dist/main.js",
    "lint": "bun --bun oxlint --type-aware --type-check",
    "lint:fix": "bun --bun oxlint --type-aware --type-check --fix",
    "test": "bun test",
    "typecheck": "bun check",
    "format": "bun fmt"
  },
  "dependencies": {
    "@apollo/auth": "workspace:*",
    "@apollo/chat": "workspace:*",
    "@apollo/database": "workspace:*",
    "@apollo/services": "workspace:*",
    "@apollo/trades": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@apollo/lint": "workspace:*",
    "@apollo/typescript": "workspace:*",
    "@effect/eslint-plugin": "catalog:",
    "@effect/language-service": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
