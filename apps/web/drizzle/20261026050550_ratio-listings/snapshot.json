    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"trade_listing_wants\",\"trade_listing_wants_shape_chk\"]",
      "set": {
        "value": "CASE \"kind\"\n        WHEN 'exact' THEN coalesce(\"count\", 0) > 0 AND num_nulls(\"slug\", \"artist\", \"member\", \"season\", \"class\", \"on_offline\") = 0 AND num_nonnulls(\"artists\", \"members\", \"seasons\", \"classes\", \"on_offlines\", \"amount\", \"currency\") = 0\n        WHEN 'range' THEN coalesce(\"count\", 0) > 0 AND num_nulls(\"artists\", \"members\", \"seasons\", \"classes\", \"on_offlines\") = 0 AND num_nonnulls(\"slug\", \"artist\", \"member\", \"season\", \"class\", \"on_offline\", \"amount\", \"currency\") = 0\n        WHEN 'choice' THEN coalesce(\"count\", 0) > 0 AND num_nonnulls(\"slug\", \"artist\", \"member\", \"season\", \"class\", \"on_offline\", \"artists\", \"members\", \"seasons\", \"classes\", \"on_offlines\", \"amount\", \"currency\") = 0\n        ELSE coalesce(\"amount\", 0) > 0 AND \"currency\" IS NOT NULL AND num_nonnulls(\"count\", \"slug\", \"artist\", \"member\", \"season\", \"class\", \"on_offline\", \"artists\", \"members\", \"seasons\", \"classes\", \"on_offlines\") = 0\n      END"
      }
    }
