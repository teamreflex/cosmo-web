  "deltas": [
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"trade_offers\",\"trade_offers_trade_chk\"]",
      "set": {
        "value": "\"kind\" = 'listing' OR (\"to_address\" IS NOT NULL AND \"offers\" IS NULL AND \"note\" IS NULL AND \"payment_side\" IS NULL)"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"trade_offers\",\"trade_offers_payment_chk\"]",
      "set": {
        "value": "\"kind\" = 'trade' OR num_nulls(\"payment_side\", \"offers\", nullif(cardinality(\"payment_methods\"), 0)) IN (0, 3)"
      }
    }
