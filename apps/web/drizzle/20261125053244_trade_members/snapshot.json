    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"trade_listing_wants\",\"trade_listing_wants_shape_chk\"]",
      "set": {
        "value": "CASE \"kind\"\n        WHEN 'exact' THEN coalesce(\"count\", 0) > 0 AND num_nulls(\"slug\", \"artist\", \"member\", \"members\", \"season\", \"class\", \"on_offline\") = 0 AND cardinality(\"members\") > 0 AND num_nonnulls(\"amount\", \"currency\") = 0\n        WHEN 'range' THEN coalesce(\"count\", 0) > 0 AND num_nonnulls(\"slug\", \"artist\", \"member\", \"members\", \"season\", \"class\", \"on_offline\", \"amount\", \"currency\") = 0\n        WHEN 'choice' THEN coalesce(\"count\", 0) > 0 AND num_nonnulls(\"slug\", \"artist\", \"member\", \"members\", \"season\", \"class\", \"on_offline\", \"amount\", \"currency\") = 0\n        ELSE coalesce(\"amount\", 1) > 0 AND \"currency\" IS NOT NULL AND num_nonnulls(\"count\", \"slug\", \"artist\", \"member\", \"members\", \"season\", \"class\", \"on_offline\") = 0\n      END"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"trade_offer_items\",\"trade_offer_items_objekt_chk\"]",
      "set": {
        "value": "CASE \"kind\" WHEN 'objekt' THEN num_nulls(\"token_id\", \"slug\", \"artist\", \"member\", \"members\", \"season\", \"class\", \"on_offline\") = 0 AND cardinality(\"members\") > 0 AND num_nonnulls(\"amount\", \"currency\", \"method\", \"marked_paid_at\", \"confirmed_at\") = 0 ELSE num_nonnulls(\"token_id\", \"slug\", \"artist\", \"member\", \"members\", \"season\", \"class\", \"on_offline\", \"transferred_at\", \"tx_hash\") = 0 AND coalesce(\"amount\", 0) > 0 AND \"currency\" IS NOT NULL AND NOT \"live\" END"
      }
    }
