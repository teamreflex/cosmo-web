    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"trade_listing_wants\",\"trade_listing_wants_shape_chk\"]",
      "set": {
        "value": "CASE \"kind\"\n        WHEN 'exact' THEN coalesce(\"count\", 0) > 0 AND num_nulls(\"slug\", \"artist\", \"member\", \"season\", \"class\", \"on_offline\") = 0 AND num_nonnulls(\"amount\", \"currency\") = 0\n        WHEN 'range' THEN coalesce(\"count\", 0) > 0 AND num_nonnulls(\"slug\", \"artist\", \"member\", \"season\", \"class\", \"on_offline\", \"amount\", \"currency\") = 0\n        WHEN 'choice' THEN coalesce(\"count\", 0) > 0 AND num_nonnulls(\"slug\", \"artist\", \"member\", \"season\", \"class\", \"on_offline\", \"amount\", \"currency\") = 0\n        ELSE coalesce(\"amount\", 1) > 0 AND \"currency\" IS NOT NULL AND num_nonnulls(\"count\", \"slug\", \"artist\", \"member\", \"season\", \"class\", \"on_offline\") = 0\n      END"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"trade_offers\",\"trade_offers_trade_chk\"]",
      "set": {
        "value": "\"kind\" = 'listing' OR (\"to_address\" IS NOT NULL AND \"offers\" IS NULL AND \"note\" IS NULL AND \"payment_side\" IS NULL)"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"trade_offers\",\"trade_offers_unit_size_chk\"]",
      "set": {
        "value": "CASE \"kind\" WHEN 'listing' THEN num_nulls(\"unit_size\", \"max_units\") = 1 AND coalesce(\"unit_size\", \"max_units\") > 0 ELSE num_nulls(\"unit_size\", \"max_units\") = 2 END"
      }
    }
  ]
