    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "trade_offers",
        "name": "trade_offers_payment_chk",
        "value": "num_nulls(\"payment_side\", \"offers\", nullif(cardinality(\"payment_methods\"), 0)) IN (0, 3)",
        "entityType": "checks"
      }
    },
    {
      "op": "drop",
      "key": "columns\u0000[\"public\",\"trade_offer_items\",\"marked_paid_at\"]"
    },
    {
      "op": "alter",
      "key": "enums\u0000[\"public\",\"payment_method\"]",
      "set": {
        "values": [
          "paypal_ff",
          "wise",
          "bank_transfer",
          "promptpay",
          "kakaopay",
          "toss",
          "gcash",
          "alipay",
          "wechat_pay",
          "venmo",
          "cashapp",
          "other"
        ]
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"trade_offer_items\",\"trade_offer_items_objekt_chk\"]",
      "set": {
        "value": "CASE \"kind\" WHEN 'objekt' THEN num_nulls(\"token_id\", \"slug\", \"artist\", \"member\", \"season\", \"class\", \"on_offline\") = 0 AND num_nonnulls(\"amount\", \"currency\", \"method\", \"confirmed_at\") = 0 ELSE num_nonnulls(\"token_id\", \"slug\", \"artist\", \"member\", \"season\", \"class\", \"on_offline\", \"transferred_at\", \"tx_hash\") = 0 AND coalesce(\"amount\", 0) > 0 AND \"currency\" IS NOT NULL AND NOT \"live\" END"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"trade_offers\",\"trade_offers_trade_chk\"]",
      "set": {
        "value": "\"kind\" = 'listing' OR (\"to_address\" IS NOT NULL AND \"offers\" IS NULL AND \"note\" IS NULL AND \"payment_side\" IS NULL AND cardinality(\"payment_methods\") = 0)"
      }
    }
  ]
