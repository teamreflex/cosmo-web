    "@apollo/util": "workspace:*",
    "@apollo/util-server": "workspace:*",
    "@aws-sdk/client-ses": "^3.1158.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@effect/atom-react": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^6.0.1",
    "@inlang/paraglide-js-react": "^1.0.3",
