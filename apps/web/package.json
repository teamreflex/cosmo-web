{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "env": "bun run --bun --env-file=../../.env --env-file=../../.env.local",
    "dev": "bun run env -- vite",
    "build": "bun run env -- vite build",
    "build:prod": "bun run --bun i18n && bun run --bun typecheck && bun run --bun vite build --mode production",
    "preview": "bun run build && bun run env -- start",
    "start": "bun run --bun --preload ./instrument.ts main.ts",
    "test": "bun test",
    "lint": "bun oxlint --type-aware --type-check",
    "lint:fix": "bun oxlint --type-aware --type-check --fix",
    "typecheck": "tsc --pretty --noEmit",
    "format": "oxfmt .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:upgrade": "drizzle-kit up",
    "db:check": "drizzle-kit check",
    "db:migrate": "bun run env -- drizzle-kit migrate",
    "db:seed": "bun run env -- bun run scripts/seed.ts",
    "auth:generate": "bun run env -- bunx @better-auth/cli generate --output ../../packages/database/src/auth.ts --y",
    "i18n": "bunx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/i18n"
  },
  "dependencies": {
    "@apollo/cosmo": "workspace:*",
    "@apollo/database": "workspace:*",
    "@apollo/redis": "workspace:*",
    "@apollo/util": "workspace:*",
    "@apollo/util-server": "workspace:*",
    "@aws-sdk/client-ses": "^3.1113.0",
    "@better-auth/api-key": "1.6.29",
    "@better-auth/drizzle-adapter": "1.6.29",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/bun": "catalog:",
    "@sentry/tanstackstart-react": "^10.72.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-virtual": "^3.14.10",
    "@tanstack/router-core": "^1.171.27",
    "better-auth": "1.6.29",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fast-average-color-node": "^3.2.0",
    "input-otp": "^1.5.0",
    "jose": "catalog:",
    "motion": "^13.1.1",
    "ofetch": "catalog:",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "^7.85.0",
    "react-intersection-observer": "^11.0.0",
    "react-player": "^3.4.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "typesense": "catalog:",
    "usehooks-ts": "^3.1.1",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@apollo/lint": "workspace:*",
    "@apollo/typescript": "workspace:*",
    "@inlang/paraglide-js": "2.25.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@types/bun": "catalog:",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/umami": "^2.10.1",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "catalog:",
    "eslint-plugin-drizzle": "^0.2.3",
    "oxc-transform-react": "^0.147.0",
    "tailwindcss": "^4.3.3",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.2.2"
  },
  "engines": {
    "bun": ">=1.3.3"
  }
}
