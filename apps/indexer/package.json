{
  "name": "indexer",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "rm -rf lib/ && tsc -p tsconfig.build.json",
    "start": "squid-typeorm-migration apply && bun run --preload ./lib/instrument.js lib/main.js",
    "lint": "bun --bun oxlint --type-aware --type-check",
    "lint:fix": "bun --bun oxlint --type-aware --type-check --fix",
    "typecheck": "bun check",
    "format": "bun fmt"
  },
  "dependencies": {
    "@apollo/cosmo": "workspace:*",
    "@apollo/image": "workspace:*",
    "@apollo/serial-estimation": "workspace:*",
    "@apollo/util": "workspace:*",
    "@sentry/bun": "catalog:",
    "@subsquid/evm-abi": "^1.0.0",
    "@subsquid/evm-codec": "^1.0.0",
    "@subsquid/evm-processor": "^1.30.2",
    "@subsquid/typeorm-migration": "^1.4.1",
    "@subsquid/typeorm-store": "^1.9.3",
    "glob": "^14.0.4",
    "lru-cache": "^11.5.3",
    "path-scurry": "^3.0.0",
    "typeorm": "^0.3.31",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@apollo/lint": "workspace:*",
    "@apollo/typescript": "workspace:*",
    "@subsquid/commands": "^2.3.1",
    "@subsquid/evm-typegen": "^5.0.0",
    "@subsquid/typeorm-codegen": "^2.4.0",
    "@types/bun": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
