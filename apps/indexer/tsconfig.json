{
  "extends": "@apollo/typescript/tsconfig.node.json",

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", ".turbo", "lib"],

  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["bun"],

    // TypeORM decorators
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Workspace packages are consumed as .ts source with explicit .ts
    // extensions (required by Node type stripping at runtime)
    "rewriteRelativeImportExtensions": true,

    // Build output
    "declaration": false,
    "sourceMap": true,

    // Path aliases
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
