{
  "extends": "@apollo/typescript/tsconfig.bun.json",

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", ".turbo", "dist"],

  "compilerOptions": {
    "types": ["bun"],
    // @apollo/mail's templates are TSX
    "jsx": "react-jsx",
    "exactOptionalPropertyTypes": true,
    "plugins": [{ "name": "@effect/language-service" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
